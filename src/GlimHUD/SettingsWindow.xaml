<Window x:Class="GlimHUD.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Loc.SettingsTitle}" Width="640" Height="790" MinWidth="540" MinHeight="540"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResizeWithGrip"
        AllowsTransparency="True" Background="Transparent" Foreground="#ECEFF4"
        FontFamily="Segoe UI" FontSize="13" TextOptions.TextFormattingMode="Display" Loaded="Window_Loaded" Closed="Window_Closed">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#ECEFF4"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#939AA8"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#11141A"/>
            <Setter Property="BorderBrush" Value="#242933"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource DarkCheckBox}">
            <Setter Property="Foreground" Value="#DDE1E8"/>
            <Setter Property="Margin" Value="0,0,22,11"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="Slider" BasedOn="{StaticResource CyanSlider}">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
            <Setter Property="MinHeight" Value="26"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#E5E9F0"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Item" Background="Transparent" CornerRadius="5" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="#222833"/></Trigger>
                            <Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="#1D2633"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#E5E9F0"/>
            <Setter Property="Background" Value="#0B0E13"/>
            <Setter Property="BorderBrush" Value="#2C323E"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Margin" Value="0,7,0,0"/>
            <Setter Property="DisplayMemberPath" Value="Label"/>
            <Setter Property="SelectedValuePath" Value="Key"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="ComboRoot">
                            <ToggleButton Focusable="False" ClickMode="Press" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ComboSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="9">
                                            <Path Data="M 0 0 L 4 4 L 8 0" Stroke="#9BA3B2" StrokeThickness="1.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboSurface" Property="Background" Value="#151A23"/></Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" IsHitTestVisible="False" ClipToBounds="True" Margin="12,8,36,8" VerticalAlignment="Center"/>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="#10141B" BorderBrush="#2C323E" BorderThickness="1" CornerRadius="8" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Margin="0,4,0,0" Padding="4" MaxHeight="260">
                                    <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ComboRoot" Property="Opacity" Value="0.45"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HeaderButton" TargetType="Button">
            <Setter Property="Foreground" Value="#A0A8B7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="34"/><Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="#252B35"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource AccentFocusBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Foreground" Value="#E5E9F0"/>
            <Setter Property="Background" Value="#1A202A"/>
            <Setter Property="BorderBrush" Value="#343D4B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,8"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#232B38"/><Setter TargetName="Surface" Property="BorderBrush" Value="#4C5A71"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Background" Value="#121720"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentFocusBrush}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="#E5E9F0"/><Setter Property="Background" Value="#0B0E13"/><Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="BorderBrush" Value="#2C323E"/><Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Padding" Value="10,7"/><Setter Property="MinHeight" Value="38"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
                <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="9"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/></Border>
                <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#4B5567"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="GameListItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#E5E9F0"/><Setter Property="Padding" Value="10,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                <Border x:Name="Surface" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="5"><ContentPresenter/></Border>
                <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource AccentSoftBrush}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#1B212C"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Border Background="#090B0F" BorderBrush="#252B35" BorderThickness="1" CornerRadius="20" Margin="6">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="100"/><RowDefinition Height="*"/><RowDefinition Height="48"/></Grid.RowDefinitions>
            <Grid Margin="25,16,20,0" MouseLeftButtonDown="Title_MouseLeftButtonDown">
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="Glim" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="HUD" FontSize="23" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}"/><Border Background="#151B24" BorderBrush="#2A3341" BorderThickness="1" CornerRadius="6" Margin="12,5,0,4" Padding="8,2"><TextBlock x:Name="VersionBadge" Text="" Foreground="#ABB9CC" FontSize="10" VerticalAlignment="Center"/></Border></StackPanel>
                    <TextBlock Text="{DynamicResource Loc.Tagline}" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                </StackPanel>
                <Button Style="{StaticResource HeaderButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Click="Close_Click" ToolTip="{DynamicResource Loc.CloseSettings}" AutomationProperties.Name="{DynamicResource Loc.CloseSettings}">
                    <Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Width="10" Height="10" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                </Button>
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,2,24,0">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Loc.Appearance}" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="{DynamicResource Loc.Language}"/>
                            <ComboBox x:Name="LanguageCombo" SelectionChanged="Language_Changed" AutomationProperties.Name="{DynamicResource Loc.Language}"/>
                            <TextBlock Text="{DynamicResource Loc.LanguageHint}" Style="{StaticResource Muted}" Margin="0,5,0,17"/>
                            <CheckBox x:Name="StartupCheck" Content="{DynamicResource Loc.StartWithWindows}" Checked="Startup_Changed" Unchecked="Startup_Changed" Margin="0,0,0,0"/>
                            <TextBlock x:Name="StartupStatus" Style="{StaticResource Muted}" Margin="0,6,0,17"/>
                            <CheckBox x:Name="RequestAdministratorCheck" Content="{DynamicResource Loc.RequestAdministratorOnStartup}" Checked="RequestAdministrator_Changed" Unchecked="RequestAdministrator_Changed" Margin="0,0,0,6"/>
                            <TextBlock Text="{DynamicResource Loc.RequestAdministratorHint}" Style="{StaticResource Muted}" Margin="0,0,0,17"/>
                            <DockPanel><TextBlock Text="{DynamicResource Loc.BackgroundOpacity}"/><TextBlock x:Name="OpacityValue" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="{DynamicResource AccentTextBrush}"/></DockPanel>
                            <Slider x:Name="OpacitySlider" Minimum="0.05" Maximum="0.85" SmallChange="0.05" LargeChange="0.1" ValueChanged="Appearance_Changed" AutomationProperties.Name="{DynamicResource Loc.BackgroundOpacity}"/>
                            <TextBlock Text="{DynamicResource Loc.OpacityHint}" Style="{StaticResource Muted}" Margin="0,5,0,17"/>
                            <DockPanel><TextBlock Text="{DynamicResource Loc.PanelScale}"/><TextBlock x:Name="ScaleValue" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="{DynamicResource AccentTextBrush}"/></DockPanel>
                            <Slider x:Name="ScaleSlider" Minimum="0.65" Maximum="1.5" SmallChange="0.05" LargeChange="0.1" ValueChanged="Appearance_Changed" AutomationProperties.Name="{DynamicResource Loc.PanelScale}"/>
                            <CheckBox x:Name="CompactModeCheck" Content="{DynamicResource Loc.CompactMode}" Checked="CompactMode_Changed" Unchecked="CompactMode_Changed" Margin="0,15,0,6"/>
                            <TextBlock Text="{DynamicResource Loc.CompactModeHint}" Style="{StaticResource Muted}"/>
                            <WrapPanel Margin="0,19,0,0">
                                <CheckBox x:Name="FpsCheck" Content="FPS" Checked="Modules_Changed" Unchecked="Modules_Changed"/>
                                <CheckBox x:Name="CpuCheck" Content="CPU" Checked="Modules_Changed" Unchecked="Modules_Changed"/>
                                <CheckBox x:Name="GpuCheck" Content="GPU" Checked="Modules_Changed" Unchecked="Modules_Changed"/>
                                <CheckBox x:Name="RamCheck" Content="{DynamicResource Loc.Ram}" Checked="Modules_Changed" Unchecked="Modules_Changed"/>
                            </WrapPanel>
                            <CheckBox x:Name="LockedCheck" Content="{DynamicResource Loc.LockPanel}" Margin="0,5,0,0" Checked="Lock_Changed" Unchecked="Lock_Changed"/>
                            <CheckBox x:Name="SnapGridCheck" Content="{DynamicResource Loc.SnapToGrid}" Margin="0,12,0,0" Checked="SnapGrid_Changed" Unchecked="SnapGrid_Changed"/>
                            <TextBlock Text="{DynamicResource Loc.SnapToGridHint}" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Loc.AccentColor}" Style="{StaticResource SectionTitle}"/>
                            <CheckBox x:Name="WindowsAccentCheck" Content="{DynamicResource Loc.UseWindowsAccent}" Checked="AccentMode_Changed" Unchecked="AccentMode_Changed" Margin="0,0,0,13"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="43"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border x:Name="CustomColorSwatch" Width="33" Height="33" HorizontalAlignment="Left" CornerRadius="8" BorderBrush="#3C4554" BorderThickness="1" Background="{DynamicResource AccentBrush}"/>
                                <TextBox x:Name="ColorHexBox" Grid.Column="1" Style="{StaticResource DarkTextBox}" MaxLength="7" TextChanged="ColorHex_Changed" LostKeyboardFocus="ColorHex_LostFocus" AutomationProperties.Name="{DynamicResource Loc.CustomColorHex}"/>
                                <Button x:Name="ChooseColorButton" Grid.Column="2" Content="{DynamicResource Loc.ChooseColor}" Style="{StaticResource ActionButton}" Margin="10,0,0,0" Click="ChooseColor_Click"/>
                            </Grid>
                            <TextBlock x:Name="ColorError" Text="{DynamicResource Loc.ColorError}" Foreground="#F6A29F" FontSize="11" Margin="0,7,0,0" Visibility="Collapsed"/>
                            <TextBlock Text="{DynamicResource Loc.CustomColorHint}" Style="{StaticResource Muted}" Margin="0,9,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Loc.OverlayColors}" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="{DynamicResource Loc.TextColor}"/>
                            <ComboBox x:Name="TextColorPresetCombo" SelectionChanged="OverlayColorPreset_Changed" AutomationProperties.Name="{DynamicResource Loc.TextColor}"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="43"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border x:Name="TextColorSwatch" Width="33" Height="33" HorizontalAlignment="Left" CornerRadius="8" BorderBrush="#3C4554" BorderThickness="1" Background="{DynamicResource OverlayTextBrush}"/>
                                <TextBox x:Name="TextColorHexBox" Grid.Column="1" Style="{StaticResource DarkTextBox}" MaxLength="7" TextChanged="OverlayColorHex_Changed" LostKeyboardFocus="OverlayColorHex_LostFocus" AutomationProperties.Name="{DynamicResource Loc.TextColor}"/>
                                <Button Grid.Column="2" Content="{DynamicResource Loc.ChooseColor}" Style="{StaticResource ActionButton}" Margin="10,0,0,0" Click="ChooseTextColor_Click"/>
                            </Grid>
                            <TextBlock x:Name="TextColorError" Text="{DynamicResource Loc.ColorError}" Foreground="#F6A29F" FontSize="11" Margin="0,7,0,0" Visibility="Collapsed"/>
                            <TextBlock Text="{DynamicResource Loc.BackgroundColor}" Margin="0,18,0,0"/>
                            <ComboBox x:Name="BackgroundColorPresetCombo" SelectionChanged="OverlayColorPreset_Changed" AutomationProperties.Name="{DynamicResource Loc.BackgroundColor}"/>
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="43"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Border x:Name="BackgroundColorSwatch" Width="33" Height="33" HorizontalAlignment="Left" CornerRadius="8" BorderBrush="#3C4554" BorderThickness="1"/>
                                <TextBox x:Name="BackgroundColorHexBox" Grid.Column="1" Style="{StaticResource DarkTextBox}" MaxLength="7" TextChanged="OverlayColorHex_Changed" LostKeyboardFocus="OverlayColorHex_LostFocus" AutomationProperties.Name="{DynamicResource Loc.BackgroundColor}"/>
                                <Button Grid.Column="2" Content="{DynamicResource Loc.ChooseColor}" Style="{StaticResource ActionButton}" Margin="10,0,0,0" Click="ChooseBackgroundColor_Click"/>
                            </Grid>
                            <TextBlock x:Name="BackgroundColorError" Text="{DynamicResource Loc.ColorError}" Foreground="#F6A29F" FontSize="11" Margin="0,7,0,0" Visibility="Collapsed"/>
                            <TextBlock Text="{DynamicResource Loc.OverlayColorsHint}" Style="{StaticResource Muted}" Margin="0,10,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Loc.Glow}" Style="{StaticResource SectionTitle}"/>
                            <CheckBox x:Name="GlowEnabledCheck" Content="{DynamicResource Loc.GlowEnabled}" Checked="GlowOption_Changed" Unchecked="GlowOption_Changed" Margin="0,0,0,10"/>
                            <StackPanel x:Name="GlowOptions">
                                <TextBlock Text="{DynamicResource Loc.GlowStyle}"/>
                                <ComboBox x:Name="GlowStyleCombo" SelectionChanged="GlowStyle_Changed" AutomationProperties.Name="{DynamicResource Loc.GlowStyle}"/>
                                <TextBlock x:Name="GlowStyleHint" Style="{StaticResource Muted}" Margin="0,7,0,14"/>
                                <CheckBox x:Name="GlowReactiveCheck" Content="{DynamicResource Loc.GlowReactive}" Checked="GlowOption_Changed" Unchecked="GlowOption_Changed" Margin="0,0,0,16"/>
                                <StackPanel x:Name="GlowSensitivityOptions" Margin="0,0,0,17">
                                    <DockPanel>
                                        <TextBlock Text="{DynamicResource Loc.GlowSensitivity}"/>
                                        <TextBlock x:Name="GlowSensitivityValue" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="{DynamicResource AccentTextBrush}"/>
                                    </DockPanel>
                                    <Slider x:Name="GlowSensitivitySlider" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1" ValueChanged="GlowSensitivity_Changed" AutomationProperties.Name="{DynamicResource Loc.GlowSensitivity}"/>
                                    <TextBlock Text="{DynamicResource Loc.GlowSensitivityHint}" Style="{StaticResource Muted}" Margin="0,5,0,0"/>
                                    <Grid Margin="0,12,0,0" ToolTip="{DynamicResource Loc.GlowSignalHint}">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="46"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{DynamicResource Loc.GlowSignal}" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                                        <ProgressBar x:Name="GlowSignalMeter" Grid.Column="1" Minimum="0" Maximum="1" Value="0" Height="5" Margin="12,0,10,0" BorderThickness="0" Background="#252B35" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" AutomationProperties.Name="{DynamicResource Loc.GlowSignal}"/>
                                        <TextBlock x:Name="GlowSignalValue" Grid.Column="2" Text="0%" Style="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                                <DockPanel>
                                    <TextBlock Text="{DynamicResource Loc.GlowIntensity}"/>
                                    <TextBlock x:Name="GlowIntensityValue" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="{DynamicResource AccentTextBrush}"/>
                                </DockPanel>
                                <Slider x:Name="GlowIntensitySlider" Minimum="0" Maximum="1" SmallChange="0.05" LargeChange="0.1" ValueChanged="GlowIntensity_Changed" AutomationProperties.Name="{DynamicResource Loc.GlowIntensity}"/>
                            </StackPanel>
                            <TextBlock Text="{DynamicResource Loc.GlowHint}" Style="{StaticResource Muted}" Margin="0,10,0,0"/>
                            <TextBlock x:Name="GlowAudioStatus" Style="{StaticResource Muted}" Margin="0,8,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Loc.Player}" Style="{StaticResource SectionTitle}"/>
                            <CheckBox x:Name="MusicCheck" Content="{DynamicResource Loc.ShowPlayer}" Checked="Modules_Changed" Unchecked="Modules_Changed" Margin="0,0,0,10"/>
                            <TextBlock Text="{DynamicResource Loc.ShowPlayerHint}" Style="{StaticResource Muted}" Margin="0,0,0,14"/>
                            <CheckBox x:Name="WheelVolumeCheck" Content="{DynamicResource Loc.ScrollVolume}" Checked="PlayerOptions_Changed" Unchecked="PlayerOptions_Changed" Margin="0,0,0,6"/>
                            <TextBlock Text="{DynamicResource Loc.ScrollVolumeHint}" Style="{StaticResource Muted}" Margin="0,0,0,18"/>
                            <TextBlock Text="{DynamicResource Loc.MusicSource}"/>
                            <ComboBox x:Name="MediaCombo" SelectionChanged="Media_Changed" AutomationProperties.Name="{DynamicResource Loc.MusicSource}"/>
                            <TextBlock x:Name="MediaStatus" Style="{StaticResource Muted}" Margin="0,7,0,15"/>
                            <TextBlock Text="{DynamicResource Loc.VolumeApp}"/>
                            <ComboBox x:Name="AudioCombo" SelectionChanged="Audio_Changed" AutomationProperties.Name="{DynamicResource Loc.VolumeAppAccessible}"/>
                            <TextBlock x:Name="AudioStatus" Style="{StaticResource Muted}" Margin="0,7,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Loc.AutoShow}" Style="{StaticResource SectionTitle}"/>
                            <CheckBox x:Name="AutoShowCheck" Content="{DynamicResource Loc.ShowOnlyInGames}" Checked="AutoShow_Changed" Unchecked="AutoShow_Changed" Margin="0,0,0,8"/>
                            <TextBlock Text="{DynamicResource Loc.AutoShowHint}" Style="{StaticResource Muted}" Margin="0,0,0,17"/>
                            <TextBlock Text="{DynamicResource Loc.ManualGames}" Margin="0,0,0,7"/>
                            <ListBox x:Name="GamePathsList" MinHeight="62" MaxHeight="145" Background="#0B0E13" BorderBrush="#2C323E" BorderThickness="1" Padding="3" ItemContainerStyle="{StaticResource GameListItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="GamePath_SelectionChanged" AutomationProperties.Name="{DynamicResource Loc.ManualGames}">
                                <ListBox.ItemTemplate><DataTemplate><StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding FullPath}" Style="{StaticResource Muted}" FontSize="10" Margin="0,3,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                </StackPanel></DataTemplate></ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="GamePathsStatus" Style="{StaticResource Muted}" Margin="0,7,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,11,0,0">
                                <Button Content="{DynamicResource Loc.AddExe}" Style="{StaticResource ActionButton}" Click="AddGame_Click"/>
                                <Button x:Name="RemoveGameButton" Content="{DynamicResource Loc.RemoveGame}" Style="{StaticResource ActionButton}" Margin="9,0,0,0" IsEnabled="False" Click="RemoveGame_Click"/>
                            </StackPanel>
                            <TextBlock Text="{DynamicResource Loc.ManualGamesHint}" Style="{StaticResource Muted}" Margin="0,12,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Loc.SystemMetrics}" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="{DynamicResource Loc.GraphicsCard}"/>
                            <ComboBox x:Name="GpuCombo" SelectionChanged="Gpu_Changed" AutomationProperties.Name="{DynamicResource Loc.GraphicsCard}"/>
                            <TextBlock x:Name="HardwareStatus" Style="{StaticResource Muted}" Margin="0,7,0,15"/>
                            <TextBlock Text="{DynamicResource Loc.FpsSource}"/>
                            <ComboBox x:Name="FpsCombo" SelectionChanged="Fps_Changed" DropDownOpened="Fps_DropDownOpened" AutomationProperties.Name="{DynamicResource Loc.FpsSource}"/>
                            <TextBlock x:Name="FpsStatus" Style="{StaticResource Muted}" Margin="0,7,0,0"/>
                            <WrapPanel x:Name="FpsRecoveryActions" Orientation="Horizontal" Margin="0,10,0,0" Visibility="Collapsed">
                                <Button x:Name="RetryFpsButton" Content="{DynamicResource Loc.RetryFps}" Style="{StaticResource ActionButton}" Click="RetryFps_Click" Margin="0,0,8,8"/>
                                <Button x:Name="RestartAdminButton" Content="{DynamicResource Loc.RestartAdmin}" Style="{StaticResource ActionButton}" Click="RestartAdmin_Click" Visibility="Collapsed" ToolTip="{DynamicResource Loc.FpsAccessHint}" Margin="0,0,0,8"/>
                            </WrapPanel>
                            <TextBlock x:Name="FpsAccessHint" Text="{DynamicResource Loc.FpsAccessHint}" Style="{StaticResource Muted}" Margin="0,8,0,0" Visibility="Collapsed"/>
                            <TextBlock Text="{DynamicResource Loc.TelemetryHint}" Style="{StaticResource Muted}" Margin="0,13,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="NetworkCard" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Loc.Network}" Style="{StaticResource SectionTitle}" Margin="0,0,0,15"/>
                            <CheckBox x:Name="NetworkCheck" Content="{DynamicResource Loc.ShowNetwork}" Checked="Modules_Changed" Unchecked="Modules_Changed" Margin="0,0,0,10"/>
                            <TextBlock Text="{DynamicResource Loc.NetworkAdapter}"/>
                            <ComboBox x:Name="NetworkAdapterCombo" SelectionChanged="NetworkAdapter_Changed" AutomationProperties.Name="{DynamicResource Loc.NetworkAdapter}"/>
                            <TextBlock x:Name="NetworkAdapterNameValue" FontWeight="SemiBold" Margin="0,9,0,3"/>
                            <TextBlock x:Name="NetworkStatusText" Style="{StaticResource Muted}"/>
                            <Border Background="#0B0E13" BorderBrush="#242933" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,12,0,0">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,10,10"><TextBlock Text="{DynamicResource Loc.NetworkDownload}" Style="{StaticResource Muted}"/><TextBlock x:Name="NetworkDownloadValue" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextBrush}" Margin="0,3,0,0"/></StackPanel>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,10"><TextBlock Text="{DynamicResource Loc.NetworkUpload}" Style="{StaticResource Muted}"/><TextBlock x:Name="NetworkUploadValue" FontSize="18" FontWeight="SemiBold" Foreground="#DCB7F5" Margin="0,3,0,0"/></StackPanel>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,10,0"><TextBlock Text="{DynamicResource Loc.NetworkReceived}" Style="{StaticResource Muted}"/><TextBlock x:Name="NetworkReceivedValue" Margin="0,3,0,0"/></StackPanel>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0"><TextBlock Text="{DynamicResource Loc.NetworkSent}" Style="{StaticResource Muted}"/><TextBlock x:Name="NetworkSentValue" Margin="0,3,0,0"/></StackPanel>
                                    </Grid>
                                    <TextBlock Text="{DynamicResource Loc.NetworkSessionHint}" Style="{StaticResource Muted}" FontSize="11" Margin="0,9,0,0"/>
                                </StackPanel>
                            </Border>
                            <DockPanel Margin="0,12,0,0"><TextBlock Text="{DynamicResource Loc.NetworkLinkSpeed}"/><TextBlock x:Name="NetworkLinkSpeedValue" DockPanel.Dock="Right" HorizontalAlignment="Right" FontWeight="SemiBold"/></DockPanel>
                            <TextBlock Text="{DynamicResource Loc.NetworkLinkHint}" Style="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/>
                            <DockPanel Margin="0,13,0,6"><TextBlock Text="{DynamicResource Loc.NetworkHistory}" Style="{StaticResource Muted}"/><TextBlock x:Name="NetworkHistoryScaleValue" DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource Muted}" FontSize="11"/></DockPanel>
                            <Border Background="#0B0E13" BorderBrush="#242933" BorderThickness="1" CornerRadius="9" Padding="10">
                                <Grid Height="72">
                                    <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                    <Border Grid.Row="0" BorderBrush="#202630" BorderThickness="0,0,0,1"/>
                                    <Border Grid.Row="1" BorderBrush="#202630" BorderThickness="0,0,0,1"/>
                                    <Canvas x:Name="NetworkHistoryPlot" Grid.RowSpan="3" ClipToBounds="True" SizeChanged="NetworkHistory_SizeChanged" AutomationProperties.Name="{DynamicResource Loc.NetworkHistory}">
                                        <Path x:Name="NetworkDownloadHistory" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" StrokeLineJoin="Round"/>
                                        <Path x:Name="NetworkUploadHistory" Stroke="#DCB7F5" StrokeThickness="2" StrokeDashArray="4,3" StrokeLineJoin="Round"/>
                                    </Canvas>
                                    <TextBlock x:Name="NetworkHistoryEmpty" Grid.RowSpan="3" Text="{DynamicResource Loc.NetworkHistoryWaiting}" Style="{StaticResource Muted}" MaxWidth="300" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <DockPanel Margin="0,5,0,0"><TextBlock Text="{DynamicResource Loc.NetworkHistoryStart}" Style="{StaticResource Muted}" FontSize="11"/><TextBlock Text="{DynamicResource Loc.NetworkHistoryNow}" DockPanel.Dock="Right" HorizontalAlignment="Right" Style="{StaticResource Muted}" FontSize="11"/></DockPanel>
                            <TextBlock Text="{DynamicResource Loc.NetworkHint}" Style="{StaticResource Muted}" FontSize="11" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Loc.Controls}" Style="{StaticResource SectionTitle}"/>
                            <ItemsControl x:Name="HotkeyList" AutomationProperties.Name="{DynamicResource Loc.Controls}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Gesture}" Foreground="{DynamicResource AccentTextBrush}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Description}" TextWrapping="Wrap"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="HotkeyFailureStatus" Foreground="#F6A29F" FontSize="12" TextWrapping="Wrap" Margin="0,2,0,10" Visibility="Collapsed"/>
                            <TextBlock Text="{DynamicResource Loc.HotkeysHint}" Style="{StaticResource Muted}" Margin="0,2,0,9"/>
                            <TextBlock Text="{DynamicResource Loc.DragHint}" Style="{StaticResource Muted}" Margin="0,7,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border x:Name="UpdatesCard" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Loc.Updates}" Style="{StaticResource SectionTitle}"/>
                            <TextBlock x:Name="UpdateCurrentVersion" Style="{StaticResource Muted}" Margin="0,0,0,14"/>
                            <CheckBox x:Name="AutomaticUpdatesCheck" Content="{DynamicResource Loc.AutomaticUpdates}" Checked="AutomaticUpdates_Changed" Unchecked="AutomaticUpdates_Changed" Margin="0,0,0,7"/>
                            <TextBlock x:Name="UpdateModeHint" Style="{StaticResource Muted}"/>
                            <Border Background="#0B0E13" BorderBrush="#242933" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,15,0,0">
                                <StackPanel>
                                    <TextBlock x:Name="UpdateStatusText"/>
                                    <ProgressBar x:Name="UpdateProgressBar" Minimum="0" Maximum="1" Height="5" Margin="0,10,0,0" BorderThickness="0" Background="#252B35" Foreground="{DynamicResource AccentBrush}" Visibility="Collapsed" AutomationProperties.Name="{DynamicResource Loc.UpdateProgress}"/>
                                </StackPanel>
                            </Border>
                            <WrapPanel Margin="0,14,0,0">
                                <Button x:Name="CheckUpdatesButton" Content="{DynamicResource Loc.CheckUpdates}" Style="{StaticResource ActionButton}" Click="CheckUpdates_Click" Margin="0,0,10,10"/>
                                <Button x:Name="DownloadUpdateButton" Content="{DynamicResource Loc.DownloadUpdate}" Style="{StaticResource ActionButton}" Click="DownloadUpdate_Click" Margin="0,0,10,10" Visibility="Collapsed"/>
                                <Button x:Name="InstallUpdateButton" Content="{DynamicResource Loc.InstallUpdate}" Style="{StaticResource ActionButton}" Click="InstallUpdate_Click" Margin="0,0,10,10" Visibility="Collapsed"/>
                                <Button Content="{DynamicResource Loc.ReleaseNotes}" Style="{StaticResource ActionButton}" Click="OpenReleases_Click" ToolTip="{DynamicResource Loc.OpenReleasesHint}" Margin="0,0,0,10"/>
                            </WrapPanel>
                            <TextBlock x:Name="UpdateLinkError" Foreground="#F6A29F" FontSize="12" Margin="0,2,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Loc.Support}" Style="{StaticResource SectionTitle}"/>
                            <TextBlock Text="{DynamicResource Loc.SupportHint}" Style="{StaticResource Muted}"/>
                            <WrapPanel Margin="0,14,0,0">
                                <Button Content="{DynamicResource Loc.ReportIssue}" Style="{StaticResource ActionButton}" Click="OpenIssues_Click" ToolTip="{DynamicResource Loc.OpenIssuesHint}" Margin="0,0,10,10"/>
                                <Button Content="{DynamicResource Loc.Repository}" Style="{StaticResource ActionButton}" Click="OpenRepository_Click" ToolTip="{DynamicResource Loc.OpenRepositoryHint}" Margin="0,0,0,10"/>
                            </WrapPanel>
                            <TextBlock x:Name="ProjectLinkStatus" Foreground="#F6A29F" FontSize="12" Margin="0,2,0,0" Visibility="Collapsed"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="2" BorderBrush="#1E232C" BorderThickness="0,1,0,0" Margin="25,0">
                <TextBlock x:Name="SaveStatus" Text="{DynamicResource Loc.AutoSave}" Foreground="#818A9A" FontSize="11" VerticalAlignment="Center"/>
            </Border>
        </Grid>
    </Border>
</Window>
