<Application x:Class="GlimHUD.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="AccentBrush" Color="#66DFFF" />
            <SolidColorBrush x:Key="AccentTextBrush" Color="#66DFFF" />
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#1466DFFF" />
            <SolidColorBrush x:Key="AccentBorderBrush" Color="#4466DFFF" />
            <SolidColorBrush x:Key="AccentPanelBorderBrush" Color="#1466DFFF" />
            <SolidColorBrush x:Key="AccentCoverBrush" Color="#2566DFFF" />
            <SolidColorBrush x:Key="AccentCoverBorderBrush" Color="#1866DFFF" />
            <SolidColorBrush x:Key="AccentDividerBrush" Color="#1C66DFFF" />
            <SolidColorBrush x:Key="AccentHoverBrush" Color="#2666DFFF" />
            <SolidColorBrush x:Key="AccentPressedBrush" Color="#4566DFFF" />
            <SolidColorBrush x:Key="AccentOnBrush" Color="#07121D" />
            <SolidColorBrush x:Key="AccentThumbBrush" Color="#CDF4FF" />
            <SolidColorBrush x:Key="AccentThumbHoverBrush" Color="#E8FAFF" />
            <SolidColorBrush x:Key="AccentFocusBrush" Color="#E0F9FF" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
